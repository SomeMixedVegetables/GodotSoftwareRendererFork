[gd_scene load_steps=12 format=3]

; Lines and points, drawn with the GPU's line command and as small tiles:
; a wire cube (lines with vertex colours), a helix (a line strip), two grids
; of points (point_size 4, and the default 1), a lit ribbon (a triangle
; strip), and a long wire box that reaches past the camera, so its lines are
; cut at the near plane. The meshes come from tools/make_line_meshes.gd.

[ext_resource type="ArrayMesh" path="res://meshes/wire_cube.tres" id="wire_cube"]
[ext_resource type="ArrayMesh" path="res://meshes/helix.tres" id="helix"]
[ext_resource type="ArrayMesh" path="res://meshes/dots.tres" id="dots"]
[ext_resource type="ArrayMesh" path="res://meshes/ribbon.tres" id="ribbon"]

[sub_resource type="Environment" id="env"]
background_mode = 1
background_color = Color(0.1, 0.1, 0.14, 1)
ambient_light_source = 2
ambient_light_color = Color(1, 1, 1, 1)
ambient_light_energy = 0.3

[sub_resource type="StandardMaterial3D" id="vertex_lines"]
shading_mode = 0
vertex_color_use_as_albedo = true

[sub_resource type="StandardMaterial3D" id="big_points"]
shading_mode = 0
vertex_color_use_as_albedo = true
use_point_size = true
point_size = 4.0

[sub_resource type="StandardMaterial3D" id="ribbon_mat"]
albedo_color = Color(0.95, 0.55, 0.85, 1)

[sub_resource type="StandardMaterial3D" id="rail_mat"]
shading_mode = 0
albedo_color = Color(0.5, 0.85, 1, 1)

[node name="LinesPoints" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("env")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.2, 4.2)

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, -0.354, 0.354, 0, 0.707, 0.707, -0.5, -0.612, 0.612, 0, 5, 0)

[node name="WireCube" type="MeshInstance3D" parent="."]
transform = Transform3D(0.819, 0, 0.574, 0, 1, 0, -0.574, 0, 0.819, -2, 0.5, 0)
mesh = ExtResource("wire_cube")
surface_material_override/0 = SubResource("vertex_lines")

[node name="Helix" type="MeshInstance3D" parent="."]
