[gd_scene load_steps=12 format=3]

; GPUParticles3D, simulated by Godot on the GPU and read back by the PS1
; renderer: billboards coloured by a ramp and turned by their angle (left,
; local coordinates), cubes that spin as they rise (middle, global
; coordinates), and an emitter with two draw passes (right). A fixed seed and
; no randomness keep every run the same.

[sub_resource type="Environment" id="env"]
background_mode = 1
background_color = Color(0.16, 0.16, 0.22, 1)
ambient_light_source = 2
ambient_light_color = Color(1, 1, 1, 1)
ambient_light_energy = 0.35

[sub_resource type="Gradient" id="ramp"]
colors = PackedColorArray(1, 0.9, 0.3, 1, 0.9, 0.2, 0.4, 1)

[sub_resource type="GradientTexture1D" id="ramp_tex"]
gradient = SubResource("ramp")

[sub_resource type="ParticleProcessMaterial" id="sparks"]
direction = Vector3(0, 1, 0)
spread = 0.0
initial_velocity_min = 1.0
initial_velocity_max = 1.0
gravity = Vector3(0, -0.4, 0)
angle_min = 0.0
angle_max = 0.0
angular_velocity_min = 120.0
angular_velocity_max = 120.0
color_ramp = SubResource("ramp_tex")

[sub_resource type="StandardMaterial3D" id="spark_mat"]
shading_mode = 0
vertex_color_use_as_albedo = true
billboard_mode = 3

[sub_resource type="QuadMesh" id="spark_quad"]
material = SubResource("spark_mat")
size = Vector2(0.25, 0.25)

[sub_resource type="ParticleProcessMaterial" id="rise"]
direction = Vector3(0, 1, 0)
spread = 0.0
initial_velocity_min = 0.8
initial_velocity_max = 0.8
gravity = Vector3(0, 0, 0)
particle_flag_rotate_y = true
angular_velocity_min = 90.0
angular_velocity_max = 90.0
scale_min = 0.6
scale_max = 0.6

[sub_resource type="StandardMaterial3D" id="cube_mat"]
albedo_color = Color(0.3, 0.7, 0.95, 1)

[sub_resource type="BoxMesh" id="cube"]
material = SubResource("cube_mat")
size = Vector3(0.3, 0.3, 0.3)

[sub_resource type="ParticleProcessMaterial" id="fan"]
direction = Vector3(1, 1, 0)
spread = 0.0
initial_velocity_min = 0.7
initial_velocity_max = 0.7
gravity = Vector3(0, -0.3, 0)

[sub_resource type="StandardMaterial3D" id="pass2_mat"]
albedo_color = Color(0.95, 0.5, 0.2, 1)

[sub_resource type="SphereMesh" id="pass2"]
material = SubResource("pass2_mat")
radius = 0.08
height = 0.16
radial_segments = 8
rings = 4

[node name="GPUParticles" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("env")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.985, 0.174, 0, -0.174, 0.985, 0, 1.4, 4.2)

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, -0.354, 0.354, 0, 0.707, 0.707, -0.5, -0.612, 0.612, 0, 5, 0)

[node name="Sparks" type="GPUParticles3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 0, 0)
amount = 12
lifetime = 1.6
use_fixed_seed = true
local_coords = true
process_material = SubResource("sparks")
draw_pass_1 = SubResource("spark_quad")

[node name="Cubes" type="GPUParticles3D" parent="."]
amount = 6
lifetime = 2.4
use_fixed_seed = true
process_material = SubResource("rise")
draw_pass_1 = SubResource("cube")

[node name="TwoPasses" type="GPUParticles3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.2, 0.3, 0)
amount = 8
lifetime = 1.8
use_fixed_seed = true
process_material = SubResource("fan")
draw_passes = 2
draw_pass_1 = SubResource("spark_quad")
draw_pass_2 = SubResource("pass2")
